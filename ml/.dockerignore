models/pretrained/yolo11s-pose.pt
models/pretrained/yolo11n-pose.pt
models/pretrained/yolo11n.pt
# play_classifier: lstm_model.pth と lstm_config.json のみ必要
models/play_classifier/lstm_20260129_092234/

# データファイル（学習・テスト用のためサービスには不要）
data/

# 開発用ファイル
.venv/
scripts/notebooks/
__pycache__/
**/__pycache__/
*.pyc
*.pyo
